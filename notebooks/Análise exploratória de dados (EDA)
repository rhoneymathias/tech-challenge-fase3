r que media)\n","resumo_salario = df_silver.groupby(\"nivel\")[\"salario_estimado\"].agg(\n","    mediana=\"median\", media=\"mean\", n=\"count\"\n",").reindex([\"Júnior\", \"Pleno\", \"Sênior\", \"Especialista/Staff+\"])\n","print(\"Salario estimado por nivel (R$):\")\n","print(resumo_salario.round(0))\n","\n","# 4. mesmo cruzamento, mas por ano tambem - pra ver se o gap entre niveis mudou\n","resumo_por_ano = df_silver.groupby([\"ano_pesquisa\", \"nivel\"])[\"salario_estimado\"].median().unstack()\n","resumo_por_ano = resumo_por_ano.reindex(columns=[\"Júnior\", \"Pleno\", \"Sênior\", \"Especialista/Staff+\"])\n","print(\"\\nMediana salarial por nivel, por ano:\")\n","print(resumo_por_ano.round(0))\n","\n","# 5. grafico\n","import matplotlib.pyplot as plt\n","plt.figure(figsize=(7,4))\n","plt.bar(resumo_salario.index, resumo_salario[\"mediana\"])\n","plt.title(\"Mediana salarial estimada por nível\")\n","plt.ylabel(\"R$ (ponto médio da faixa)\")\n","for i, v in enumerate(resumo_salario[\"mediana\"]):\n","    plt.text(i, v+500, f\"R$ {v:,.0f}\", ha=\"center\")\n","plt.savefig(\"/content/grafico_salario_por_nivel.png\", dpi=150, bbox_inches=\"tight\")\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":690},"id":"KLmu-8XpQX8H","executionInfo":{"status":"ok","timestamp":1787184829651,"user_tz":180,"elapsed":265,"user":{"displayName":"Rhoney Mathias","userId":"14463956065845044105"}},"outputId":"d872e44c-22fb-40a7-f920-11fef0dd8de0"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Salario estimado por nivel (R$):\n","                     mediana    media     n\n","nivel                                      \n","Júnior                3500.0   4051.0  2431\n","Pleno                 7000.0   7903.0  3545\n","Sênior               14000.0  14229.0  3850\n","Especialista/Staff+  18000.0  20029.0   349\n","\n","Mediana salarial por nivel, por ano:\n","nivel         Júnior   Pleno   Sênior  Especialista/Staff+\