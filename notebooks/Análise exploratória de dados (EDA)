*"],"metadata":{"id":"elGO-oTZS8xP"}},{"cell_type":"code","source":["# Generaliza o que fizemos manualmente pra \"genero\" -> agora para TODAS as colunas\n","# de TODOS os anos, de uma vez, guardando o resultado numa tabela.\n","\n","import re\n","import unicodedata\n","\n","def parse_coluna_2023(c):\n","    # mesma regex que usamos manualmente, agora dentro de uma função reutilizável\n","    match = re.match(r\"^\\('([^']*)',\\s*'(.*)'\\)$\", c, re.DOTALL)\n","    if match:\n","        return match.group(1).strip(), match.group(2).strip()\n","    return c, c  # fallback, caso alguma coluna não bata no padrão esperado\n","\n","def parse_coluna_outros(c):\n","    # mesmo .partition(\"_\") que usamos manualmente pra 2024/2025\n","    codigo, sep, texto = c.partition(\"_\")\n","    return (codigo, texto) if sep else (c, c)\n","\n","def normaliza(texto):\n","    texto = texto.lower().strip()\n","    texto = unicodedata.normalize('NFKD', texto).encode('ascii', 'ignore').decode('ascii')\n","    # NOVO: troca underscore, barra, vírgula e outros separadores por espaço,\n","    # depois colapsa espaços múltiplos em um só - assim \"cargo_atual\" e\n","    # \"cargo atual\" viram exatamente a mesma string\n","    texto = re.sub(r\"[^a-z0-9]+\", \" \", texto).strip()\n","    return texto\n","\n","# Aplica a função em CADA coluna de CADA ano - isso substitui o trabalho manual\n","registros = []\n","for coluna in dataset_2023.columns:\n","    codigo, texto = parse_coluna_2023(coluna)\n","    registros.append({\"ano\": \"2023\", \"coluna_original\": coluna, \"codigo\": codigo, \"pergunta_normalizada\": normaliza(texto)})\n","\n","for coluna in dataset_2024.columns:\n","    codigo, texto = parse_coluna_outros(coluna)\n","    registros.append({\"ano\": \"2024\", \"coluna_original\": coluna, \"codigo\": codigo, \"pergunta_normalizada\": normaliza(texto)})\n","\n","for coluna in dataset_2025.columns:\n","    codigo, texto = parse_coluna_outros(coluna)\n","    registros.append({\"ano\": \"2025-2026\", \"coluna_original\": coluna, \"codigo\": codigo, \"pergunta_normalizada\": normaliza(texto)})\n","\n","df_todas_colunas = pd.DataFrame(registros)\n","print(f\"Total de colunas processadas: {len(df_todas_colunas)}\")\n","df_todas_colunas.head(10)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":380},"id":"Pte3d-V9S8_o","executionInfo":{"status":"ok","timestamp":1787184826271,"user_tz":180,"elapsed":21,"user":{"displayName":"Rhoney Mathias","userId":"14463956065845044105"}},"outputId":"c8830087-ff99-4fb9-ba22-21a908e8780a"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Total de colunas processadas: 1190\n"]},{"output_type":"execute_result","data":{"text/plain":["    ano                                    coluna_original  codigo  \\\n","0  2023                                       ('P0', 'id')      P0   \n","1  2023                                 ('P1_a ', 'Idade')    P1_a   \n","2  2023                         ('P1_a_1 ', 'Faixa idade')  P1_a_1   \n","3  2023                                ('P1_b ', 'Genero')    P1_b   \n","4  2023                        ('P1_c ', 'Cor/raca/etnia')    P1_c   \n","5  2023                                   ('P1_d ', 'PCD')    P1_d   \n","6  2023  ('P1_e ', 'experiencia_profissional_prejudicada')    P1_e   \n","7  2023  ('P1_e_1 ', 'Não acredito que minha experiênci...  P1_e_1   \n","8  2023  ('P1_e_2 ', 'Experiencia prejudicada devido a ...  P1_e_2   \n","9  2023  ('P1_e_3 ', 'Experiencia prejudicada devido a ...  P1_e_3   \n","\n","                                pergunta_normalizada  \n","0                                                 id  \n","1                                              idade  \n","2                                        faixa idade  \n","3                                             genero  \n","4                                     cor raca etnia  \n","5                                                pcd  \n","6               experien